# OpenMeter collector service env — copied to openmeter-collector/.env at runtime.
#
#   cp openmeter-collector/.env.example openmeter-collector/.env
#   $EDITOR openmeter-collector/.env

# --- Kafka (event consume) ---
KAFKA_BROKERS=kafka:9092
KAFKA_GATEWAY_TOPIC=livepeer-gateway-events

# --- OpenMeter / Konnect (required) ---
# Match the region of your Konnect org (US vs EU). Bootstrap scripts read OPENMETER_URL;
# the collector reads OPENMETER_INGEST_URL (same host, /events suffix).
#   US: https://us.api.konghq.com/v3/openmeter
#   EU: https://eu.api.konghq.com/v3/openmeter
OPENMETER_URL=https://us.api.konghq.com/v3/openmeter
OPENMETER_INGEST_URL=https://us.api.konghq.com/v3/openmeter/events
OPENMETER_API_KEY=
ETH_USD_PRICE=3500
