{
  "$comment": "OpenMeter/Konnect metering catalog for the clearinghouse collector. Aligned with pymthouse v0.3.3: Starter plans settle on network_spend (network_fee_usd_micros) via credit_then_invoice + discounts.usage included allowance; prepaid credits are manual top-ups only (not auto-granted here). billable_usd_micros / billable_spend remain for phase-2 markup and are not on Starter rate cards. Analytics meters need collector fields from the owner-identity / fee-mapping PR. Provisioned idempotently by bootstrap.sh / bootstrap.ps1 — meters are immutable (create-only).",
  "meters": [
    {
      "key": "network_fee_usd_micros",
      "name": "Network fee (USD micros)",
      "description": "Settlement + observability: exact fractional USD micros from fee_wei * eth_usd / 1e12 (no per-ticket ceil).",
      "event_type": "create_signed_ticket",
      "aggregation": "sum",
      "value_property": "$.network_fee_usd_micros",
      "dimensions": {
        "client_id": "$.client_id",
        "external_user_id": "$.external_user_id",
        "model_id": "$.model_id",
        "pipeline": "$.pipeline"
      }
    },
    {
      "key": "billable_usd_micros",
      "name": "Billable usage (USD micros)",
      "description": "Phase-2 post-markup billable amount. Not on Starter plans; collector may emit interim passthrough equal to network fee.",
      "event_type": "create_signed_ticket",
      "aggregation": "sum",
      "value_property": "$.billable_usd_micros",
      "dimensions": {
        "client_id": "$.client_id",
        "external_user_id": "$.external_user_id",
        "model_id": "$.model_id",
        "pipeline": "$.pipeline"
      }
    },
    {
      "key": "signed_ticket_count",
      "name": "Signed ticket count",
      "description": "Count of create_signed_ticket events (request volume).",
      "event_type": "create_signed_ticket",
      "aggregation": "count",
      "dimensions": {
        "client_id": "$.client_id",
        "external_user_id": "$.external_user_id",
        "model_id": "$.model_id",
        "pipeline": "$.pipeline"
      }
    },
    {
      "key": "fee_wei",
      "name": "Fee (wei)",
      "description": "Analytics: raw network fee in wei.",
      "event_type": "create_signed_ticket",
      "aggregation": "sum",
      "value_property": "$.fee_wei",
      "dimensions": {
        "client_id": "$.client_id",
        "external_user_id": "$.external_user_id",
        "model_id": "$.model_id",
        "pipeline": "$.pipeline",
        "manifest_id": "$.manifest_id"
      }
    },
    {
      "key": "billable_secs",
      "name": "Billable seconds",
      "description": "Analytics: billable session seconds.",
      "event_type": "create_signed_ticket",
      "aggregation": "sum",
      "value_property": "$.billable_secs",
      "dimensions": {
        "client_id": "$.client_id",
        "external_user_id": "$.external_user_id",
        "model_id": "$.model_id",
        "pipeline": "$.pipeline",
        "manifest_id": "$.manifest_id"
      }
    },
    {
      "key": "network_fee_usd_micros_by_manifest",
      "name": "Network fee by manifest (USD micros)",
      "description": "Analytics: network fee rolled up per manifest/session.",
      "event_type": "create_signed_ticket",
      "aggregation": "sum",
      "value_property": "$.network_fee_usd_micros",
      "dimensions": {
        "client_id": "$.client_id",
        "external_user_id": "$.external_user_id",
        "model_id": "$.model_id",
        "pipeline": "$.pipeline",
        "manifest_id": "$.manifest_id"
      }
    }
  ],
  "features": [
    {
      "key": "network_spend",
      "name": "Network spend",
      "meter_key": "network_fee_usd_micros"
    },
    {
      "key": "billable_spend",
