{
  "openapi": "3.1.0",
  "info": {
    "title": "Clearinghouse Builder API",
    "version": "1.0.0",
    "description": "Machine-facing Builder API for clearinghouse integrators. Provisions Auth0 end-users, OpenMeter customers, and mints short-lived signer JWTs."
  },
  "servers": [
    {
      "url": "http://localhost:8095",
      "description": "Local builder-api (openmeter-collector container)"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Session",
      "description": "RFC 8693 signer JWT exchange"
    },
    {
      "name": "Users",
      "description": "Authenticated end-user usage, live balance, and API-key rotation"
    },
    {
      "name": "Apps",
      "description": "M2M app-admin user provisioning"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/oidc/token": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "RFC 8693 signer session token exchange",
        "description": "Exchanges an Auth0 end-user access token or end-user API key (`sk_*`) for a short-lived signer JWT. The target app is inferred from the `subject_token`. Accepts JSON (preferred) or `application/x-www-form-urlencoded`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenExchangeRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signer session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerSession"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, grant, target, or unsupported token type"
          },
          "401": {
            "description": "Invalid client credentials"
          },
          "402": {
            "description": "Insufficient allowance"
          }
        }
      }
    },
    "/api/v1/users/me/usage": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Query metered usage for the authenticated user",
        "description": "Identity is derived from the Bearer signer JWT. The meter slug is fixed by OPENMETER_TRIAL_FEATURE_KEY via the provisioned catalog.",
        "security": [
          {
            "signerBearer": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "groupBy",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usage rows scoped to the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid time window"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "502": {
            "description": "Metering backend unavailable"
          },
          "503": {
            "description": "JWT verifier or metering backend is not configured"
          }
        }
      }
    },
    "/api/v1/users/me/balance": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Read the authenticated user's live balance",
        "description": "Identity is derived from the Bearer signer JWT. Returns the same live credit/entitlement snapshot token exchange uses for allowance, scoped to OPENMETER_TRIAL_FEATURE_KEY.",
        "security": [
          {
            "signerBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Live balance for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "OpenMeter customer not found"
          },
          "502": {
            "description": "Metering backend unavailable"
          },
          "503": {
            "description": "JWT verifier or metering backend is not configured"
          }
        }
      }
    },
    "/api/v1/users/me/api-key": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Rotate the authenticated user's API key",
        "description": "Issues a new long-lived end-user API key (`sk_*`). Identity is derived from a subject token (Bearer header or form `subject_token`). The previous key is invalidated immediately.",
        "security": [
          {
            "subjectBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubjectTokenRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/SubjectTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key rotated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RotateAPIKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid subject token"
          },
          "404": {
            "description": "User not found"
          },
          "503": {
            "description": "Subject resolution or Auth0 is not configured"
          }
        }
      }
    },
    "/api/v1/apps/{clientId}/users": {
      "post": {
        "tags": [
          "Apps"
        ],
        "summary": "Create or upsert an end-user",
        "description": "Creates an Auth0 Database user, upserts the OpenMeter customer, and optionally issues an end-user API key.",
        "security": [
          {
            "m2mBasic": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Public Auth0 client id for the integrator app"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUserResponse"
                }
              }
            }
          },
          "200": {
            "description": "User updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "m2mBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "M2M client id and secret (users:write)"
      },
      "signerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Signer JWT minted by POST /api/v1/oidc/token"
      },
      "subjectBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Auth0 user JWT or end-user API key (sk_*). May also be supplied as subject_token."
      }
    },
    "schemas": {
      "SubjectTokenRequest": {
        "type": "object",
        "properties": {
          "subject_token": {
            "type": "string",
            "description": "Alternative to Authorization Bearer; Auth0 user JWT or end-user API key (sk_*)"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "externalUserId"
        ],
        "properties": {
          "externalUserId": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "connection": {
            "type": "string"
          },
          "issueApiKey": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "externalUserId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "apiKey": {
            "type": "string",
            "description": "Returned once when issueApiKey is true"
          }
        }
      },
      "RotateAPIKeyResponse": {
        "type": "object",
        "required": [
          "clientId",
          "externalUserId",
          "apiKey",
          "status"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "externalUserId": {
            "type": "string"
          },
          "apiKey": {
            "type": "string",
            "description": "New plaintext API key returned once"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "UsageRow": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number"
          },
          "groupBy": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "required": [
          "clientId",
          "externalUserId",
          "meter",
          "subject",
          "rows"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "externalUserId": {
            "type": "string"
          },
          "meter": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageRow"
            }
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "required": [
          "clientId",
          "externalUserId",
          "subject",
          "feature",
          "hasAccess",
          "balanceUsdMicros",
          "source"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "externalUserId": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "hasAccess": {
            "type": "boolean"
          },
          "balanceUsdMicros": {
            "type": "integer",
            "format": "int64",
            "description": "Live allowance in USD micros"
          },
          "source": {
            "type": "string",
            "enum": [
              "credits",
              "entitlement",
              "none"
            ]
          }
        }
      },
      "TokenExchangeRequest": {
        "type": "object",
        "required": [
          "grant_type",
          "subject_token",
          "subject_token_type"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "urn:ietf:params:oauth:grant-type:token-exchange"
            ]
          },
          "subject_token": {
            "type": "string",
            "description": "Auth0 user access token (JWT) or end-user API key (sk_*)"
          },
          "subject_token_type": {
            "type": "string",
            "enum": [
              "urn:ietf:params:oauth:token-type:access_token"
            ]
          },
          "requested_token_type": {
            "type": "string",
            "enum": [
              "urn:ietf:params:oauth:token-type:access_token"
            ]
          },
          "audience": {
            "type": "string",
            "description": "Must match configured signer audience when provided"
          },
          "resource": {
            "type": "string",
            "description": "Must match configured signer audience when provided"
          }
        }
      },
      "SignerSession": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "scope",
          "has_access",
          "balance_usd_micros"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer"
          },
          "scope": {
            "type": "string"
          },
          "signer_url": {
            "type": "string",
            "format": "uri"
          },
          "discovery_url": {
            "type": "string",
            "format": "uri"
          },
          "issued_token_type": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "has_access": {
            "type": "boolean",
            "description": "Whether the customer currently has allowance. Always present."
          },
          "balance_usd_micros": {
            "type": "integer",
            "format": "int64",
            "description": "Allowance balance in USD micros. Always present."
          }
        }
      }
    }
  }
}
